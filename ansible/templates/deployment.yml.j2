apiVersion: apps/v1
kind: Deployment
metadata:
  name: azure-cicd-demo
  namespace: cicd-demo
  labels:
    app.kubernetes.io/name: azure-cicd-demo
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: azure-cicd-demo
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  template:
    metadata:
      labels:
        app.kubernetes.io/name: azure-cicd-demo
    spec:
      containers:
        - name: azure-cicd-demo
          image: "{{ image_ref }}"
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8080
              protocol: TCP
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 20
            periodSeconds: 10
            timeoutSeconds: 2
            failureThreshold: 3
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
